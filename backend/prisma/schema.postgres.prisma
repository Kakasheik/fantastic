// =====================================================================
// Fantastic — Schema Prisma (PostgreSQL/Supabase, p/ produção).
// Para ativar: copiar conteúdo para schema.prisma + ajustar provider.
// =====================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearch"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SUBSCRIBER
  CREATOR
  ADVERTISER
  ADMIN
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CANCELLED
  EXPIRED
  TRIAL
}

enum TransactionType {
  SUBSCRIPTION
  PPV
  TIP
  AD_CREDIT
  WITHDRAWAL
  REFUND
}

enum TransactionStatus {
  PENDING
  COMPLETED
  REFUNDED
  CHARGEBACK
  FAILED
}

enum PostType {
  PHOTO
  VIDEO
  AUDIO
  TEXT
}

// (mesmas tabelas do schema SQLite, com:
//  - String → @db.Citext / @db.Text quando aplicável
//  - Float → Decimal(12,2)
//  - String JSON → Json
//  - String enum → enums Prisma
//  - @db.Uuid em todos os IDs)
//
// Em vez de duplicar 300 linhas, mantenha schema.prisma como SQLite (dev) e
// gere o Postgres via npm script "schema:prod" que faz substituições.
