# =====================================================================
# Fantastic — Variáveis de ambiente (template)
#
# Copie para .env e preencha com valores reais. NUNCA commitar .env.
# =====================================================================

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ----------------------------------------------------
# Banco de Dados — Supabase / PostgreSQL
# ----------------------------------------------------
# DATABASE_URL: usado em runtime (com pgbouncer/pooler)
# DIRECT_URL:   usado pelas migrations Prisma (conexão direta)
DATABASE_URL=postgresql://fantastic:fantastic@localhost:5432/fantastic?schema=public
DIRECT_URL=postgresql://fantastic:fantastic@localhost:5432/fantastic?schema=public

POSTGRES_DB=fantastic
POSTGRES_USER=fantastic
POSTGRES_PASSWORD=change-me

# ----------------------------------------------------
# Redis (sessões, rate limit, pub/sub)
# ----------------------------------------------------
REDIS_URL=redis://localhost:6379

# ----------------------------------------------------
# JWT
# ----------------------------------------------------
# Gere com: openssl rand -hex 64
JWT_ACCESS_SECRET=replace-with-random-64-byte-hex
JWT_REFRESH_SECRET=replace-with-different-random-64-byte-hex
COOKIE_SECRET=replace-with-32-byte-hex

# ----------------------------------------------------
# Storage — Cloudflare R2 (preferido) ou AWS S3
# ----------------------------------------------------
S3_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=fantastic-media
S3_ACCESS_KEY=
S3_SECRET_KEY=
CDN_HOST=https://cdn.fantastic.com.br

# ----------------------------------------------------
# Mux (streaming de vídeo + Server-Side Watermark)
# ----------------------------------------------------
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Signing key para JWT de playback assinado
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_SECRET=
# Webhook
MUX_WEBHOOK_SECRET=

# ----------------------------------------------------
# Gateway de Pagamento — escolha um (ccbill | segpay)
# ----------------------------------------------------
PAYMENT_PROVIDER=ccbill

# CCBill (global, +18 friendly)
CCBILL_ACCOUNT_NUM=
CCBILL_SUB_ACCOUNT=
CCBILL_FLEXFORM_ID=
CCBILL_SALT=
CCBILL_WEBHOOK_SECRET=

# SegPay (suporta Pix BR)
SEGPAY_MERCHANT_ID=
SEGPAY_PACKAGE_ID=
SEGPAY_API_KEY=
SEGPAY_WEBHOOK_SECRET=

# ----------------------------------------------------
# KYC / Verificação de Idade (Lei 15.211/2025)
# ----------------------------------------------------
SUMSUB_API_KEY=
SUMSUB_SECRET=
SUMSUB_LEVEL_NAME=basic-kyc-level

# ----------------------------------------------------
# E-mails transacionais
# ----------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=no-reply@fantastic.com.br

# ----------------------------------------------------
# Watermark / LGPD
# ----------------------------------------------------
WATERMARK_SECRET=replace-with-32-byte-hex
LGPD_SALT=replace-with-32-byte-hex

# ----------------------------------------------------
# Monitoramento
# ----------------------------------------------------
SENTRY_DSN=
PROMETHEUS_ENABLED=true

# ----------------------------------------------------
# Frontend (variáveis públicas)
# ----------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:4000/chat
NEXT_PUBLIC_SENTRY_DSN=
